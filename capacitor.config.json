{
  "appId": "org.buddhistsocietiesofaustralia.sati",
  "appName": "Sati",
  "webDir": "public",
  "ios": {
    "contentInset": "never",
    "scheme": "Sati",
    "backgroundColor": "#f6efe3",
    "limitsNavigationsToAppBoundDomains": false
